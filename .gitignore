# ════════════════════════════════════════════════════════════════
# Dabba — .gitignore
# ════════════════════════════════════════════════════════════════

# ─── Secrets & Environment (CRITICAL) ───────────────────────────
.env
.env.*
*.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
kaggle.json
credentials.json
client_secret*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.publishsettings

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ─── Data (raw + processed datasets, large artifacts) ───────────
data/raw/
data/processed/
*.csv
*.xlsx
!data/processed/.gitkeep
!data/raw/README.md

# ─── Model artifacts ─────────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.index
models/*.onnx
models/*.npy
!models/.gitkeep

# ─── Reports / Generated figures (including SHAP values) ─────────
reports/figures/*.png
reports/figures/*.html
reports/figures/*.json
reports/figures/*.svg
reports/figures/*.npy
reports/ab_scenarios.json
reports/*.csv
reports/mlruns/
!reports/figures/.gitkeep

# ─── MLflow ──────────────────────────────────────────────────────
mlflow_data/
mlruns/

# ─── Python bytecode / build artifacts ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.so
.Python

# ─── Virtual environments ────────────────────────────────────────
.venv/
venv/
env/
virtualenv/
.venv*/
env.bak/
venv.bak/

# ─── IDE / Editor ────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.code-workspace
.history/
.ipynb_checkpoints/

# ─── OS files ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.dmg
*.tmp
*.temp
*.bak

# ─── Node.js ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/
*.dump
*.stackdump

# ─── Coverage / Testing ──────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
radar_balance.txt

# ─── Linting / Formatting caches ─────────────────────────────────
.ruff_cache/
.mypy_cache/
.types_cache/

# ─── Database files ──────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
